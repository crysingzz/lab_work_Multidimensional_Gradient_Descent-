import "IEcoBase1.idl";
import "IEcoArtificialIntelligence.idl";

typedef int16_t (ECOCALLMETHOD *EcoIterationObserver)(
    [in] const double_t* weights,
    [in] uint32_t count,
    [in] uint32_t completedUpdates,
    [in] voidptr_t context);

[
    uuid(1C56BC65-1759-4278-80AF-4EDD861B2720)
]
interface IEcoOptimizationTrace : IEcoUnknown {
    int16_t OptimizeObserved([in] IEcoVector* initial,
        [in] EcoLossFunction loss, [in] voidptr_t context,
        [in] double_t learningRate, [in] uint32_t maxIterations,
        [in] double_t differenceStep, [in] double_t gradientTolerance,
        [in] EcoIterationObserver observer, [in] voidptr_t observerContext,
        [out] IEcoVector** outWeights, [out] uint32_t* outIterations,
        [out] bool_t* outConverged, [out] double_t* outLoss);
};
